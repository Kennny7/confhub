# Copy to .env and replace values as needed. Never commit .env.
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8090
# Required before exposing the API beyond localhost. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
API_KEY=

# Database: SQLite for local development; use PostgreSQL in production.
DATABASE_URL=sqlite+aiosqlite:///./data/confhub.db

# Your real identity used as the join display name when joining as yourself.
DEFAULT_USER_NAME=
DEFAULT_USER_EMAIL=
DEFAULT_USER_LOCATION=
DEFAULT_USER_TIMEZONE=Asia/Kolkata
# Used only when joining in bot/assistant mode (optional legacy path).
DEFAULT_DISPLAY_NAME=ConfHub Assistant (Bot)

# Microsoft Teams: requires a separately deployed .NET calling-bot gateway.
TEAMS_GATEWAY_URL=
TEAMS_GATEWAY_TOKEN=
TEAMS_WEBHOOK_SECRET=
TEAMS_RECORDING_GATEWAY_ENABLED=false

# Google Meet OAuth. Use an OAuth client created in Google Cloud Console.
GOOGLE_OAUTH_CLIENT_FILE=./secrets/google-oauth-client.json
GOOGLE_TOKEN_FILE=./secrets/google-token.json
GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/meetings.space.readonly

# Zoom OAuth. Create an OAuth app at marketplace.zoom.us.
ZOOM_OAUTH_CLIENT_ID=
ZOOM_OAUTH_CLIENT_SECRET=
ZOOM_OAUTH_REDIRECT_URI=http://localhost:8091/zoom/callback
ZOOM_TOKEN_FILE=./secrets/zoom-token.json

# Cisco Webex OAuth. Create an integration at developer.webex.com.
WEBEX_OAUTH_CLIENT_ID=
WEBEX_OAUTH_CLIENT_SECRET=
WEBEX_OAUTH_REDIRECT_URI=http://localhost:8091/webex/callback
WEBEX_TOKEN_FILE=./secrets/webex-token.json

# Optional OpenAI-compatible local LLM. Leave LLM_BASE_URL empty to disable AI summarization.
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=not-required-for-local-server
LLM_ENABLE_THINKING=false

# Data handling defaults. Recording is disabled by default.
RECORDING_ENABLED=false
RECORDING_ROOT=./data/recordings
RECORDING_RETENTION_DAYS=30
REQUIRE_RECORDING_CONSENT=true
TRANSCRIPT_RETENTION_DAYS=90
